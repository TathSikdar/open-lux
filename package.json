{
  "name": "open-lux",
  "version": "1.0.0",
  "description": "Ambient-light driven brightness for DDC/CI monitors, with a measured per-display calibration",
  "license": "GPL-3.0-or-later",
  "author": "Tath Sikdar <rikisikdar1@gmail.com>",
  "homepage": "https://github.com/TathSikdar/open-lux",
  "repository": {
    "type": "git",
    "url": "https://github.com/TathSikdar/open-lux.git"
  },
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "fake": "electron . --fake",
    "test": "node --test \"test/*.test.js\"",
    "icon": "electron tools/icon.cjs",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "serialport": "^13.0.0"
  },
  "optionalDependencies": {
    "@hensm/ddcci": "^0.1.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.tathsikdar.openlux",
    "productName": "open-lux",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/icon.png",
      "category": "Utility"
    }
  }
}
