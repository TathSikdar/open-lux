/* open-lux theme.
 *
 * Warm near-black rather than the usual blue-tinted dark, one orange accent,
 * pill buttons, and a serif for display type against a sans body. A light
 * palette is the same sheet with different tokens.
 *
 * The placeholders below are substituted from theme.py by ui.load_style().
 * QSS already uses braces for its rule blocks, so this is string.Template,
 * not str.format -- which also means a bare dollar sign cannot appear in this
 * file, comments included. Every placeholder must exist in theme.py, and
 * tests/test_theme.py fails if one does not.
 */

QWidget {
    background: $bg;
    color: $text;
    font-family: "Segoe UI", "Inter", "Cantarell", "DejaVu Sans", sans-serif;
    font-size: $font;
}

/* Anything that sits inside a card must not paint its own background, or it
   punches a window-coloured rectangle through the card -- invisible against
   the near-black dark theme, obvious as a grey band on the light one. #pane is
   the plain QWidget used as a layout container (see heading() and _slider()).
   Note that a label given padding starts drawing a background it never asked
   for, so this has to stay. */
QLabel, QCheckBox, QRadioButton, QSlider, #pane { background: transparent; }

/* The pages live inside scroll areas so the window can be dragged shorter than
   its contents; neither the area nor its viewport should paint anything. */
QScrollArea, QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: $border_hi;
    border-radius: 5px;
    min-height: 28px;
}
QScrollBar::handle:vertical:hover { background: $muted; }
/* Qt draws step arrows and a page-gap widget unless they are zeroed out. */
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

/* ---- sidebar ---- */

#sidebar {
    background: $sidebar;
    border-right: 1px solid $border;
}

#brand {
    font-family: Georgia, "Iowan Old Style", "DejaVu Serif", "Liberation Serif", serif;
    font-size: $brand_size;
    color: $text;
    padding-left: 8px;
}

QPushButton#nav {
    background: transparent;
    border: 1px solid transparent;
    border-radius: $radius;
    padding: $nav_pad;
    text-align: left;
    color: $muted;
}
QPushButton#nav:hover { background: $hover; color: $text; }
QPushButton#nav:checked {
    background: $sel;
    border-color: $sel_border;
    color: $text;
}

/* ---- surfaces ---- */

#card {
    background: $surface;
    border: 1px solid $border;
    border-radius: $card_radius;
}

#heading {
    font-family: Georgia, "Iowan Old Style", "DejaVu Serif", "Liberation Serif", serif;
    font-size: $heading_size;
    color: $text;
}
#sub { color: $muted; }

#readout {
    font-family: Georgia, "Iowan Old Style", "DejaVu Serif", "Liberation Serif", serif;
    font-size: $readout_size;
    color: $accent;
}
#value { font-size: $value_size; font-weight: 600; color: $accent; }

/* ---- buttons ---- */

/* Qt does not clamp an oversized border-radius the way CSS does -- the
   999px pill trick silently renders as a small radius. These are set just
   over half the button height, which Qt does clamp into a true pill. */
QPushButton {
    background: $button;
    border: 1px solid $button_border;
    border-radius: $radius;
    padding: $btn_pad;
    color: $text;
}
QPushButton:hover { background: $button_hover; border-color: $border_hi; }
QPushButton:pressed { background: $button_press; }
QPushButton:disabled { color: $faint; background: $button_off; border-color: $border; }

QPushButton#primary {
    background: $accent;
    border: none;
    /* Qt's `border: none` drops the inherited radius too, unlike CSS, so it
       has to be restated here or the button comes out square. */
    border-radius: $pri_radius;
    color: $accent_fg;
    font-weight: 600;
    padding: $pri_pad;
}
QPushButton#primary:hover { background: $accent_hover; }
QPushButton#primary:pressed { background: $accent_press; }
QPushButton#primary:disabled { background: $accent_off; color: $accent_off_fg; }

/* ---- slider ---- */

QSlider::groove:horizontal {
    height: 6px;
    background: $border;
    border-radius: 3px;
}
QSlider::sub-page:horizontal { background: $accent; border-radius: 3px; }
QSlider::handle:horizontal {
    background: $handle;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover { background: $handle_hover; }

/* ---- choices ---- */

QCheckBox, QRadioButton { spacing: 10px; padding: 3px 0; }
QCheckBox:disabled, QRadioButton:disabled { color: $faint; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }

QCheckBox::indicator {
    border: 1px solid $border_hi;
    border-radius: 5px;
    background: $field;
}
QCheckBox::indicator:checked { background: $accent; border-color: $accent; }

QRadioButton::indicator {
    border: 1px solid $border_hi;
    border-radius: 9px;
    background: $field;
}
/* border-radius must be half the *outer* box (content + border) or Qt renders
   a rounded square instead of a dot. */
QRadioButton::indicator:checked {
    background: $accent;
    border: 4px solid $field;
    border-radius: 12px;
}

/* ---- inputs ---- */

/* Buttons are pills; fields are rounded rectangles. A full pill fights the
   spin-box arrows, which Qt draws as a square block in the corner. */
QComboBox, QSpinBox, QDoubleSpinBox {
    background: $field;
    border: 1px solid $button_border;
    border-radius: $field_radius;
    padding: $field_pad;
    min-width: 92px;
    color: $text;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: $border_hi; }
QComboBox::drop-down { border: none; width: 20px; }

/* The spin buttons are deliberately left unstyled: styling ::up-button drops
   Qt's built-in arrow glyphs, and restoring them means shipping image assets
   for a control that is already perfectly usable. */

QComboBox QAbstractItemView {
    background: $popup;
    border: 1px solid $button_border;
    padding: 4px;
    selection-background-color: $accent;
    selection-color: $accent_fg;
    outline: none;
}

QProgressBar {
    background: $button;
    border: none;
    border-radius: 4px;
    height: 8px;
}
QProgressBar::chunk { background: $accent; border-radius: 4px; }

/* ---- tray menu ---- */

QMenu {
    background: $surface;
    border: 1px solid $button_border;
    padding: 6px;
}
QMenu::item { padding: 8px 24px; border-radius: 8px; }
QMenu::item:selected { background: $accent; color: $accent_fg; }
QMenu::separator { height: 1px; background: $border; margin: 5px 8px; }
