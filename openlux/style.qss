/* open-lux theme. One dark palette; the graph widget paints its own. */

QWidget {
    background: #0f1115;
    color: #e8ecf4;
    font-family: "Segoe UI", "Inter", "Cantarell", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

#sidebar {
    background: #14161c;
    border-right: 1px solid #22262e;
}

#brand {
    font-size: 17px;
    font-weight: 600;
    color: #5aa9ff;
    padding-left: 6px;
}

QPushButton#nav {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    text-align: left;
    color: #9aa3b2;
}
QPushButton#nav:hover { background: #1b1f27; color: #e8ecf4; }
QPushButton#nav:checked { background: #1f2632; color: #e8ecf4; font-weight: 600; }

#card {
    background: #161920;
    border: 1px solid #232833;
    border-radius: 12px;
}

#heading { font-size: 22px; font-weight: 600; }
#sub { color: #8b94a3; }
#readout { font-size: 30px; font-weight: 600; color: #5aa9ff; }
#value { font-size: 15px; font-weight: 600; color: #5aa9ff; }

QPushButton {
    background: #1e2430;
    border: 1px solid #2c3444;
    border-radius: 8px;
    padding: 8px 16px;
}
QPushButton:hover { background: #262e3c; }
QPushButton:disabled { color: #5b6373; background: #171b23; }

QPushButton#primary {
    background: #2f6fd0;
    border: none;
    color: #ffffff;
    font-weight: 600;
    padding: 10px 18px;
}
QPushButton#primary:hover { background: #3a7ee4; }
QPushButton#primary:disabled { background: #232b38; color: #6b7484; }

QSlider::groove:horizontal {
    height: 6px;
    background: #232833;
    border-radius: 3px;
}
QSlider::sub-page:horizontal { background: #5aa9ff; border-radius: 3px; }
QSlider::handle:horizontal {
    background: #e8ecf4;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

QCheckBox, QRadioButton { spacing: 9px; padding: 2px 0; }
QCheckBox:disabled, QRadioButton:disabled { color: #5b6373; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }
QCheckBox::indicator {
    border: 1px solid #39414f;
    border-radius: 4px;
    background: #1a1f28;
}
QCheckBox::indicator:checked { background: #5aa9ff; border-color: #5aa9ff; }
QRadioButton::indicator {
    border: 1px solid #39414f;
    border-radius: 9px;
    background: #1a1f28;
    width: 16px;
    height: 16px;
}
/* border-radius has to be half the *outer* box (content + border) or Qt
   renders a rounded square instead of a dot. */
QRadioButton::indicator:checked {
    background: #5aa9ff;
    border: 4px solid #1a1f28;
    border-radius: 12px;
}

QComboBox, QSpinBox, QDoubleSpinBox {
    background: #1a1f28;
    border: 1px solid #2c3444;
    border-radius: 7px;
    padding: 6px 9px;
    min-width: 90px;
}
QComboBox::drop-down { border: none; width: 18px; }
QComboBox QAbstractItemView {
    background: #1a1f28;
    border: 1px solid #2c3444;
    selection-background-color: #2f6fd0;
}

QProgressBar {
    background: #1a1f28;
    border: none;
    border-radius: 4px;
    height: 8px;
}
QProgressBar::chunk { background: #5aa9ff; border-radius: 4px; }

QMenu {
    background: #161920;
    border: 1px solid #2c3444;
    padding: 5px;
}
QMenu::item { padding: 7px 22px; border-radius: 6px; }
QMenu::item:selected { background: #2f6fd0; }
