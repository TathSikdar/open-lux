/* open-lux theme.
 *
 * Warm near-black rather than the usual blue-tinted dark, one orange accent,
 * pill buttons, and a serif for display type against a sans body. The graph
 * widget paints itself and keeps its palette in curve.py.
 */

QWidget {
    background: #0c0c0d;
    color: #ece9e4;
    font-family: "Segoe UI", "Inter", "Cantarell", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

/* Labels must not paint their own background, or they punch dark rectangles
   through the rounded cards -- and any label given padding starts drawing a
   styled background it never asked for. */
QLabel { background: transparent; }

/* ---- sidebar ---- */

#sidebar {
    background: #121213;
    border-right: 1px solid #232325;
}

#brand {
    font-family: Georgia, "Iowan Old Style", "DejaVu Serif", "Liberation Serif", serif;
    font-size: 19px;
    color: #ece9e4;
    padding-left: 8px;
}

QPushButton#nav {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;
    padding: 9px 16px;
    text-align: left;
    color: #8f8b85;
}
QPushButton#nav:hover { background: #1b1b1d; color: #ece9e4; }
QPushButton#nav:checked {
    background: #1f1e1d;
    border-color: #37332e;
    color: #ece9e4;
}

/* ---- surfaces ---- */

#card {
    background: #131314;
    border: 1px solid #232325;
    border-radius: 16px;
}

#heading {
    font-family: Georgia, "Iowan Old Style", "DejaVu Serif", "Liberation Serif", serif;
    font-size: 27px;
    color: #ece9e4;
}
#sub { color: #8f8b85; }

#readout {
    font-family: Georgia, "Iowan Old Style", "DejaVu Serif", "Liberation Serif", serif;
    font-size: 34px;
    color: #e8752c;
}
#value { font-size: 15px; font-weight: 600; color: #e8752c; }

/* ---- buttons ---- */

/* Qt does not clamp an oversized border-radius the way CSS does -- the
   999px pill trick silently renders as a small radius. These are set just
   over half the button height, which Qt does clamp into a true pill. */
QPushButton {
    background: #1e1e20;
    border: 1px solid #2f2f32;
    border-radius: 20px;
    padding: 9px 20px;
    color: #ece9e4;
}
QPushButton:hover { background: #27272a; border-color: #3a3a3e; }
QPushButton:pressed { background: #171719; }
QPushButton:disabled { color: #56534f; background: #141416; border-color: #232325; }

QPushButton#primary {
    background: #e8752c;
    border: none;
    /* Qt's `border: none` drops the inherited radius too, unlike CSS, so it
       has to be restated here or the button comes out square. */
    border-radius: 21px;
    color: #16130f;
    font-weight: 600;
    padding: 11px 24px;
}
QPushButton#primary:hover { background: #f58a45; }
QPushButton#primary:pressed { background: #d1651f; }
QPushButton#primary:disabled { background: #2a2521; color: #6b6259; }

/* ---- slider ---- */

QSlider::groove:horizontal {
    height: 6px;
    background: #232325;
    border-radius: 3px;
}
QSlider::sub-page:horizontal { background: #e8752c; border-radius: 3px; }
QSlider::handle:horizontal {
    background: #ece9e4;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}
QSlider::handle:horizontal:hover { background: #ffffff; }

/* ---- choices ---- */

QCheckBox, QRadioButton { spacing: 10px; padding: 3px 0; }
QCheckBox:disabled, QRadioButton:disabled { color: #56534f; }
QCheckBox::indicator, QRadioButton::indicator { width: 16px; height: 16px; }

QCheckBox::indicator {
    border: 1px solid #3a3a3e;
    border-radius: 5px;
    background: #191919;
}
QCheckBox::indicator:checked { background: #e8752c; border-color: #e8752c; }

QRadioButton::indicator {
    border: 1px solid #3a3a3e;
    border-radius: 9px;
    background: #191919;
}
/* border-radius must be half the *outer* box (content + border) or Qt renders
   a rounded square instead of a dot. */
QRadioButton::indicator:checked {
    background: #e8752c;
    border: 4px solid #191919;
    border-radius: 12px;
}

/* ---- inputs ---- */

/* Buttons are pills; fields are rounded rectangles. A full pill fights the
   spin-box arrows, which Qt draws as a square block in the corner. */
QComboBox, QSpinBox, QDoubleSpinBox {
    background: #191919;
    border: 1px solid #2f2f32;
    border-radius: 12px;
    padding: 7px 14px;
    min-width: 92px;
    color: #ece9e4;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover { border-color: #3a3a3e; }
QComboBox::drop-down { border: none; width: 20px; }

/* The spin buttons are deliberately left unstyled: styling ::up-button drops
   Qt's built-in arrow glyphs, and restoring them means shipping image assets
   for a control that is already perfectly usable. */

QComboBox QAbstractItemView {
    background: #161617;
    border: 1px solid #2f2f32;
    padding: 4px;
    selection-background-color: #e8752c;
    selection-color: #16130f;
    outline: none;
}

QProgressBar {
    background: #1e1e20;
    border: none;
    border-radius: 4px;
    height: 8px;
}
QProgressBar::chunk { background: #e8752c; border-radius: 4px; }

/* ---- tray menu ---- */

QMenu {
    background: #131314;
    border: 1px solid #2f2f32;
    padding: 6px;
}
QMenu::item { padding: 8px 24px; border-radius: 8px; }
QMenu::item:selected { background: #e8752c; color: #16130f; }
QMenu::separator { height: 1px; background: #232325; margin: 5px 8px; }
